# KimBu — ortam değişkenleri
# Bu dosyayı .env.local olarak kopyalayın ve değerleri doldurun.
# .env.local git tarafından yok sayılır; gerçek değerleri ASLA bu dosyaya yazmayın.

# --- İstemciye gönderilen değerler (NEXT_PUBLIC_) ---
# Supabase panelinde: Project Settings > Data API
# Anon key tarayıcıya iner; bu normaldir. Güvenlik RLS politikalarından gelir,
# anahtarın gizliliğinden değil.
NEXT_PUBLIC_SUPABASE_URL=https://<proje-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>

# --- Yalnızca sunucu tarafı sırlar (asla NEXT_PUBLIC_ ile başlamamalı) ---
# Service role key RLS'i tamamen atlar. Tarayıcıya sızarsa veritabanı tümüyle açılır.
# Supabase panelinde: Project Settings > API Keys > service_role
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# Oyuncu oturum çerezlerini imzalamak için kullanılan HMAC anahtarı.
# En az 32 karakter olmalı. Üretmek için:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=<en-az-32-karakterlik-rastgele-dize>
